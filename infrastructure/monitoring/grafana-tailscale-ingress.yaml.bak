apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grafana-tailscale
  namespace: monitoring
  annotations:
    # Tailscale Ingress terminates HTTPS and forwards HTTP to Grafana.
    # Final private URL:
    # https://grafana.laperm-dragon.ts.net
    argocd.argoproj.io/sync-wave: "30"
spec:
  ingressClassName: tailscale
  tls:
    - hosts:
        - grafana
  rules:
    - host: grafana
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                # With releaseName kube-prometheus-stack, this is the Grafana service.
                name: kube-prometheus-stack-grafana
                port:
                  number: 80
